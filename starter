#!/usr/bin/env bash
# The AAC Compose starter.
#
#   ./starter setup [aac init options]   register your tenant and create everything with `aac init`
#   ./starter up                         start your agent, its AAC sidecar and the trust publisher
#   ./starter exercise                   run one task and show what each piece did
#   ./starter down                       stop the containers; your tenant and keys stay in ~/.aac
set -euo pipefail
cd "$(dirname "$0")"

# The hosted AAC stage service this example uses.
AAC_URL="https://api.stage.cascadeauth.dev"
TRUST_URL="https://trust.stage.cascadeauth.dev"
# One CLI profile is one tenant; one agent holds one workload's files.
PROFILE="${AAC_STARTER_PROFILE:-stage}"
AGENT="${AAC_STARTER_AGENT:-starter}"
COMPOSE_ENV="${AAC_CLI_HOME:-$HOME/.aac}/agents/$AGENT/compose.env"

compose() {
  # compose.env, written by `aac init`, tells Compose where your files are.
  # The containers run as you, so they can read the key files `aac init` made.
  AAC_STARTER_UID="$(id -u)" AAC_STARTER_GID="$(id -g)" \
    docker compose --env-file "$COMPOSE_ENV" "$@"
}

trust_is_published() {
  # The publisher signs your public root key and development CA certificate
  # with your tenant-admin key and uploads them to AAC, which serves them at
  # the trust URL; every sidecar that checks what yours signs reads them there.
  # The CLI reads them back from that URL.
  local report
  report="$(aac agent status --agent "$AGENT" --remote --output json 2>/dev/null || true)"
  [[ $report == *'"contains_root_key_id": true'* && $report == *'"contains_ca_anchor_id": true'* ]]
}

wait_for_published_keys() {
  # A first upload usually shows within seconds; five minutes is generous.
  local deadline
  deadline=$(( $(date +%s) + 300 ))
  until trust_is_published; do
    if [ "$(date +%s)" -ge "$deadline" ]; then
      echo "Your public keys are still not served at $TRUST_URL after 5 minutes." >&2
      echo "The publisher's log shows each upload attempt: docker logs aac-starter-publisher-1" >&2
      exit 1
    fi
    sleep 2
  done
}

command="${1:-help}"
[ $# -eq 0 ] || shift
case "$command" in
  setup)
    aac init --profile "$PROFILE" --agent "$AGENT" --layout container \
      --admin-url "$AAC_URL" --data-plane-url "$AAC_URL" --trust-url "$TRUST_URL" "$@"
    compose pull sidecar publisher
    ;;
  up)
    echo "Building the agent image and starting the agent, the sidecar and the publisher ..."
    compose up --detach --build --force-recreate   # rebuilt and recreated: your latest agent code and keys
    echo "Waiting until the sidecar is ready ..."
    compose run --rm client wait                   # it has loaded its identity, keys and configuration
    echo "Waiting until AAC serves your public keys at $TRUST_URL (the publisher uploads them) ..."
    wait_for_published_keys
    echo "Running. Next: ./starter exercise"
    ;;
  exercise)
    compose run --rm client exercise
    ;;
  down)
    compose down
    ;;
  *)
    sed -n '4,7p' "$0" | cut -c3-
    ;;
esac
